{
  "datasets": [
    {
      "name": "51b52f5c",
      "displayName": "orders_information",
      "config": {
        "version": "1.1",
        "source": "datatocrunch_novacart_adb.gold_schema.orders_information",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "executive_business_view",
      "displayName": "executive_business_view",
      "config": {
        "version": "1.1",
        "source": "datatocrunch_novacart_adb.gold_schema.orders_information",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "displayName": "Count"
          },
          {
            "name": "total_revenue",
            "expr": "SUM(CASE WHEN COALESCE(payment_completion_ratio, 0) >= 1 THEN COALESCE(paid_amount, order_amount) ELSE 0 END)",
            "displayName": "Total Revenue",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "average_order_value",
            "expr": "AVG(CASE WHEN COALESCE(payment_completion_ratio, 0) >= 1 THEN COALESCE(paid_amount, order_amount) END)",
            "displayName": "Average Order Value",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "completed_orders",
            "expr": "COUNT(DISTINCT CASE WHEN COALESCE(payment_completion_ratio, 0) >= 1 THEN order_id END)",
            "displayName": "Completed Orders"
          },
          {
            "name": "payment_success_rate",
            "expr": "AVG(LEAST(1.0, GREATEST(0.0, COALESCE(payment_completion_ratio, CASE WHEN LOWER(COALESCE(payment_status, '')) IN ('success', 'successful', 'paid', 'completed') THEN 1.0 WHEN LOWER(COALESCE(payment_status, '')) IN ('failed', 'failure', 'pending', 'cancelled', 'canceled', 'declined') THEN 0.0 ELSE NULL END))))",
            "displayName": "Payment Success Rate",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "total_orders",
            "expr": "COUNT(DISTINCT order_id)",
            "displayName": "Total Orders"
          },
          {
            "name": "total_paid_amount",
            "expr": "SUM(COALESCE(paid_amount, 0))",
            "displayName": "Total Paid Amount",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "gross_merchandise_value",
            "expr": "SUM(COALESCE(order_amount, 0))",
            "displayName": "Gross Merchandise Value",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "avg_payment_completion_ratio",
            "expr": "AVG(LEAST(1.0, GREATEST(0.0, COALESCE(payment_completion_ratio, CASE WHEN LOWER(COALESCE(payment_status, '')) IN ('success', 'successful', 'paid', 'completed') THEN 1.0 WHEN LOWER(COALESCE(payment_status, '')) IN ('failed', 'failure', 'pending', 'cancelled', 'canceled', 'declined') THEN 0.0 ELSE NULL END))))",
            "displayName": "Avg Payment Completion Ratio",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ]
      }
    },
    {
      "name": "pipeline_processing_health",
      "displayName": "pipeline_processing_health",
      "config": {
        "version": "1.1",
        "source": "datatocrunch_novacart_adb.silver_schema.processing_control",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "displayName": "Count"
          },
          {
            "name": "rows_merged_total",
            "expr": "SUM(COALESCE(rows_merged, 0))",
            "displayName": "Rows Merged"
          },
          {
            "name": "latest_processed_ts",
            "expr": "MAX(last_processed_bronze_ingested_at)",
            "displayName": "Latest Processed Timestamp"
          }
        ]
      }
    },
    {
      "name": "quarantine_errors",
      "displayName": "quarantine_errors",
      "queryLines": [
        "SELECT\n",
        "  error_flag,\n",
        "  COUNT(*) AS error_count\n",
        "FROM\n",
        "  (\n",
        "    SELECT\n",
        "      'to_be_verified_by_orders_team' AS error_flag\n",
        "    FROM\n",
        "      datatocrunch_novacart_adb.silver_schema.orders_quarantine\n",
        "    WHERE\n",
        "      COALESCE(\n",
        "        TRY_CAST(to_be_verified_by_orders_team AS BOOLEAN),\n",
        "        LOWER(CAST(to_be_verified_by_orders_team AS STRING)) NOT IN (\n",
        "          'false', '0', 'no', 'n', 'valid', 'ok', 'passed', ''\n",
        "        )\n",
        "      )\n",
        "    UNION ALL\n",
        "    SELECT\n",
        "      'check_order_amount' AS error_flag\n",
        "    FROM\n",
        "      datatocrunch_novacart_adb.silver_schema.orders_quarantine\n",
        "    WHERE\n",
        "      COALESCE(\n",
        "        TRY_CAST(check_order_amount AS BOOLEAN),\n",
        "        LOWER(CAST(check_order_amount AS STRING)) NOT IN (\n",
        "          'false', '0', 'no', 'n', 'valid', 'valid_amount', 'ok', 'passed', ''\n",
        "        )\n",
        "      )\n",
        "    UNION ALL\n",
        "    SELECT\n",
        "      'to_be_verified_by_products_team' AS error_flag\n",
        "    FROM\n",
        "      datatocrunch_novacart_adb.silver_schema.products_quarantine\n",
        "    WHERE\n",
        "      COALESCE(\n",
        "        TRY_CAST(to_be_verified_by_products_team AS BOOLEAN),\n",
        "        LOWER(CAST(to_be_verified_by_products_team AS STRING)) NOT IN (\n",
        "          'false', '0', 'no', 'n', 'valid', 'ok', 'passed', ''\n",
        "        )\n",
        "      )\n",
        "    UNION ALL\n",
        "    SELECT\n",
        "      'check_product_price' AS error_flag\n",
        "    FROM\n",
        "      datatocrunch_novacart_adb.silver_schema.products_quarantine\n",
        "    WHERE\n",
        "      COALESCE(\n",
        "        TRY_CAST(check_product_price AS BOOLEAN),\n",
        "        LOWER(CAST(check_product_price AS STRING)) NOT IN (\n",
        "          'false', '0', 'no', 'n', 'valid', 'valid_price', 'ok', 'passed', ''\n",
        "        )\n",
        "      )\n",
        "    UNION ALL\n",
        "    SELECT\n",
        "      'to_be_verified_by_payments_team' AS error_flag\n",
        "    FROM\n",
        "      datatocrunch_novacart_adb.silver_schema.payments_quarantine\n",
        "    WHERE\n",
        "      COALESCE(\n",
        "        TRY_CAST(to_be_verified_by_payments_team AS BOOLEAN),\n",
        "        LOWER(CAST(to_be_verified_by_payments_team AS STRING)) NOT IN (\n",
        "          'false', '0', 'no', 'n', 'valid', 'ok', 'passed', ''\n",
        "        )\n",
        "      )\n",
        "    UNION ALL\n",
        "    SELECT\n",
        "      'check_paid_amount' AS error_flag\n",
        "    FROM\n",
        "      datatocrunch_novacart_adb.silver_schema.payments_quarantine\n",
        "    WHERE\n",
        "      COALESCE(\n",
        "        TRY_CAST(check_paid_amount AS BOOLEAN),\n",
        "        LOWER(CAST(check_paid_amount AS STRING)) NOT IN (\n",
        "          'false', '0', 'no', 'n', 'valid', 'valid_amount', 'ok', 'passed', ''\n",
        "        )\n",
        "      )\n",
        "  ) flagged\n",
        "GROUP BY\n",
        "  error_flag"
      ]
    },
    {
      "name": "quarantine_counts",
      "displayName": "quarantine_counts",
      "queryLines": [
        "SELECT\n",
        "  'orders' AS entity_name,\n",
        "  COUNT(*) AS quarantine_records\n",
        "FROM\n",
        "  datatocrunch_novacart_adb.silver_schema.orders_quarantine\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'products' AS entity_name,\n",
        "  COUNT(*) AS quarantine_records\n",
        "FROM\n",
        "  datatocrunch_novacart_adb.silver_schema.products_quarantine\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'payments' AS entity_name,\n",
        "  COUNT(*) AS quarantine_records\n",
        "FROM\n",
        "  datatocrunch_novacart_adb.silver_schema.payments_quarantine"
      ]
    }
  ],
